{$SITE_DOMAIN} {
	# Дополнительные настройки TLS (обычно пусто: с доменом сертификат Let's Encrypt выпускается сам).
	{$CADDY_TLS}
	encode zstd gzip

	# Обмен с 1С снаружи закрыт. На своём сервере он будет открыт только на внутреннем адресе.
	@exchange path /api/exchange*
	respond @exchange 404

	reverse_proxy app:3000
}
