{$SITE_DOMAIN} {
	# Без домена — самоподписанный сертификат для https://IP (браузер предупредит); с доменом — пусто, сертификат Let's Encrypt.
	{$CADDY_TLS}
	encode zstd gzip

	# Обмен с 1С снаружи закрыт. На своём сервере он будет открыт только на внутреннем адресе.
	@exchange path /api/exchange*
	respond @exchange 404

	reverse_proxy app:3000
}
